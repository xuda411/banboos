BANBOOS2_ENV=production
BANBOOS2_AUTH_MODE=identity
BANBOOS2_TENANT_ENFORCEMENT=strict
# Development-only fallback; leave unset in production identity mode.
# BANBOOS2_API_TOKEN=replace-with-a-random-token-at-least-32-characters
BANBOOS2_DATABASE_URL=postgresql+asyncpg://banboos:change-me@postgres:5432/banboos2
BANBOOS2_REDIS_URL=redis://redis:6379/0
BANBOOS2_CORS_ORIGINS=https://banboos.example.com
BANBOOS2_SMS_PROVIDER=
BANBOOS2_EMAIL_PROVIDER=
BANBOOS2_WECHAT_CLIENT_ID=
# HMAC key for phone/email/WeChat identity hashes; use a secret manager in production.
BANBOOS2_IDENTITY_HASH_SECRET=
# Release pipeline must set this to RELEASE_READY after XLSM gate verification.
BANBOOS2_FINANCIAL_RELEASE_GATE=
